@model AppEnvios.Models.Cliente

@{
    ViewData["Title"] = "Detalle Cliente";
}

<h2>Detalle del Cliente</h2>

<div class="card mt-3" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@Model.Direccion</dd>

            <dt class="col-sm-4">Fecha Registro</dt>
            <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.ClienteId" class="btn btn-warning mt-2">Editar</a>
<a asp-action="Index" class="btn btn-secondary mt-2">Volver</a>