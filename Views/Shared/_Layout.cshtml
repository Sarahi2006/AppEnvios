<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppEnvios</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
        }

        .navbar {
            background: linear-gradient(90deg, #1e293b, #0f172a);
        }

        .navbar-brand {
            font-weight: bold;
            letter-spacing: 1px;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #1e293b;
            padding-top: 20px;
        }

            .sidebar a {
                color: #cbd5e1;
                text-decoration: none;
                display: block;
                padding: 10px 15px;
                border-radius: 8px;
            }

                .sidebar a:hover {
                    background-color: #334155;
                    color: white;
                }

        .content {
            padding: 30px;
        }

        footer {
            background-color: #1e293b;
            padding: 15px;
            text-align: center;
            margin-top: 40px;
        }

        .table {
            color: #f8fafc;
        }

            .table thead {
                background-color: #1e293b;
            }

        .table-striped > tbody > tr:nth-of-type(odd) {
            background-color: #1e293b;
            color: #f8fafc;
        }

        .table-striped > tbody > tr:nth-of-type(even) {
            background-color: #0f172a;
            color: #f8fafc;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        .form-control, .form-select {
            background-color: #1e293b;
            color: #f8fafc;
            border: 1px solid #334155;
        }

            .form-control:focus, .form-select:focus {
                background-color: #1e293b;
                color: #f8fafc;
                border-color: #3b82f6;
                box-shadow: 0 0 0 0.2rem rgba(59,130,246,.25);
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark px-4">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            📦 AppEnvios
        </a>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-md-2 sidebar">
                <a asp-controller="Home" asp-action="Index">🏠 Inicio</a>
                <a asp-controller="Envios" asp-action="Index">📦 Envíos</a>
                <a asp-controller="Destinatarios" asp-action="Index">📍 Destinatarios</a>

                @if (Context.Session.GetString("Rol") == "Admin")
                {
                    <a asp-controller="Clientes" asp-action="Index">👤 Clientes</a>
                    <a asp-controller="EstadosEnvio" asp-action="Index">🔄 Estados</a>
                    <a asp-controller="AuditoriasEnvio" asp-action="Index">📋 Auditoría</a>
                    <a asp-controller="Usuarios" asp-action="Index">👥 Usuarios</a>
                }

                <hr style="border-color: #334155;" />
                <a asp-controller="Account" asp-action="Logout" style="color: #f87171;">
                    🚪 Cerrar Sesión (@Context.Session.GetString("Nombre"))
                </a>
            </div>

            <!-- CONTENIDO -->
            <div class="col-md-10 content">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- FOOTER -->
    <footer>
        <p>© @DateTime.Now.Year - AppEnvios | Small Box</p>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
