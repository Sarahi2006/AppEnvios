@model IEnumerable<AppEnvios.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}
<h2>Lista de Usuarios</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Usuario</a>
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Cliente Vinculado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Nombre</td>
                <td>@usuario.Email</td>
                <td>@usuario.Rol</td>
                <td>@(usuario.Cliente?.Nombre ?? "—")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@usuario.UsuarioId"
                       class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@usuario.UsuarioId"
                       class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@usuario.UsuarioId"
                       class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>